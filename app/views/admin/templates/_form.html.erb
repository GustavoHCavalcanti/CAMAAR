<%= form_with(model: [:admin, template], local: true) do |f| %>

  <div class="card shadow-sm p-4">

    <div class="mb-3">
      <%= f.label :nome, "Nome do Template", class: "form-label fw-semibold" %>
      <%= f.text_field :nome, class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= f.label :descricao, "Descrição", class: "form-label fw-semibold" %>
      <%= f.text_area :descricao, rows: 4, class: "form-control" %>
    </div>

    <div class="d-flex justify-content-end">
      <%= f.submit class: "btn btn-primary px-4" %>
    </div>

  </div>

<% end %>