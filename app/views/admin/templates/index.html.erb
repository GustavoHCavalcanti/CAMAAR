<div class="container py-4">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold">Templates</h1>
    <%= link_to "Novo Template", new_admin_template_path, class: "btn btn-primary" %>
  </div>

  <% if @templates.any? %>
    <table class="table table-hover bg-white shadow-sm">
      <thead class="table-light">
        <tr>
          <th>ID</th>
          <th>Título</th>
          <th>Criado em</th>
          <th>Ações</th>
        </tr>
      </thead>

      <tbody>
        <% @templates.each do |template| %>
          <tr>
            <td><%= template.id %></td>
            <td><%= template.titulo %></td>
            <td><%= template.created_at.strftime("%d/%m/%Y") %></td>
            <td>
              <%= link_to "Ver", admin_template_path(template), class: "btn btn-sm btn-outline-secondary" %>
              <%= link_to "Editar", edit_admin_template_path(template), class: "btn btn-sm btn-outline-primary" %>
              <%= button_to "Excluir", admin_template_path(template),
                    method: :delete,
                    form: { data: { turbo_confirm: "Tem certeza que deseja excluir este template?" }, class: "d-inline" },
                    class: "btn btn-sm btn-outline-danger" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

  <% else %>
    <div class="alert alert-info mt-3">
      Nenhum template encontrado.
    </div>
  <% end %>

</div>