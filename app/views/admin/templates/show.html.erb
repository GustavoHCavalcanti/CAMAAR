<div class="container py-4">

  <h1 class="fw-bold mb-4"><%= @template.nome %></h1>

  <div class="card shadow-sm p-4">

    <p><strong>ID:</strong> <%= @template.id %></p>

    <p>
      <strong>Perguntas:</strong> <%= @template.questions.count %>
    </p>

    <p>
      <strong>Formulários associados:</strong> <%= @template.formularios.count %>
    </p>

    <p class="text-muted">
      Criado em <%= @template.created_at.strftime("%d/%m/%Y") %>
    </p>

    <div class="mt-3">
      <%= link_to "Editar", edit_admin_template_path(@template), class: "btn btn-primary me-2" %>
      <%= button_to "Excluir", admin_template_path(@template),
            method: :delete,
            form: { data: { turbo_confirm: "⚠️ ATENÇÃO: Ao excluir este template, todos os #{@template.formularios.count} formulário(s) associado(s) também serão excluído(s). Tem certeza?" }, class: "d-inline" },
            class: "btn btn-danger me-2" %>
      <%= link_to "Voltar", admin_templates_path, class: "btn btn-secondary" %>
    </div>

  </div>

</div>