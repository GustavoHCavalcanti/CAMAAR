<div class="container py-5">
  
  <h1 class="mb-5 fw-bold text-center">Gerenciamento do Sistema</h1>

  <div class="row g-4 justify-content-center">

    <!-- Card: Importar Dados -->
    <div class="col-md-6 col-lg-3">
      <div class="card shadow-sm h-100 text-center">
        <div class="card-body d-flex flex-column justify-content-center align-items-center p-4">
          <div class="mb-3" style="font-size: 3rem; color: #6A2A8A;">
            📥
          </div>
          <h5 class="card-title fw-bold mb-3">Importar Dados</h5>
          <p class="card-text text-muted mb-4">Importar dados CSV de alunos e turmas</p>
          <%= link_to "#", class: "btn btn-primary mt-auto" do %>
            Acessar
          <% end %>
        </div>
      </div>
    </div>

    <!-- Card: Formulários -->
    <div class="col-md-6 col-lg-3">
      <div class="card shadow-sm h-100 text-center">
        <div class="card-body d-flex flex-column justify-content-center align-items-center p-4">
          <div class="mb-3" style="font-size: 3rem; color: #6A2A8A;">
            📋
          </div>
          <h5 class="card-title fw-bold mb-3">Formulários</h5>
          <p class="card-text text-muted mb-4">Gerenciar formulários de avaliação</p>
          <%= link_to admin_formularios_path, class: "btn btn-primary mt-auto" do %>
            Acessar
          <% end %>
        </div>
      </div>
    </div>

    <!-- Card: Templates -->
    <div class="col-md-6 col-lg-3">
      <div class="card shadow-sm h-100 text-center">
        <div class="card-body d-flex flex-column justify-content-center align-items-center p-4">
          <div class="mb-3" style="font-size: 3rem; color: #6A2A8A;">
            📝
          </div>
          <h5 class="card-title fw-bold mb-3">Templates</h5>
          <p class="card-text text-muted mb-4">Gerenciar templates de perguntas</p>
          <%= link_to admin_templates_path, class: "btn btn-primary mt-auto" do %>
            Acessar
          <% end %>
        </div>
      </div>
    </div>

    <!-- Card: Turmas -->
    <div class="col-md-6 col-lg-3">
      <div class="card shadow-sm h-100 text-center">
        <div class="card-body d-flex flex-column justify-content-center align-items-center p-4">
          <div class="mb-3" style="font-size: 3rem; color: #6A2A8A;">
            🏫
          </div>
          <h5 class="card-title fw-bold mb-3">Turmas</h5>
          <p class="card-text text-muted mb-4">Gerenciar turmas e disciplinas</p>
          <%= link_to admin_turmas_path, class: "btn btn-primary mt-auto" do %>
            Acessar
          <% end %>
        </div>
      </div>
    </div>

  </div>

</div>
