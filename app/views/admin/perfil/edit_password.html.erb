<div style="max-width: 600px; margin: 40px auto; padding: 30px; background: white; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
  <h2 style="margin-bottom: 30px; color: #333;">Alterar Senha</h2>

  <% if flash[:alert] %>
    <div style="background: #fee; border-left: 3px solid #c00; padding: 12px; margin-bottom: 20px; border-radius: 4px;">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <%= form_with url: admin_edit_password_path, method: :patch, local: true do |f| %>
    <!-- Senha Atual -->
    <div style="margin-bottom: 20px;">
      <%= label_tag :current_password, "Senha Atual", style: "display: block; margin-bottom: 8px; font-weight: 500;" %>
      <%= password_field_tag :current_password, nil, 
            required: true,
            style: "width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px;" %>
    </div>

    <!-- Nova Senha -->
    <div style="margin-bottom: 20px;">
      <%= label_tag :new_password, "Nova Senha", style: "display: block; margin-bottom: 8px; font-weight: 500;" %>
      <%= password_field_tag :new_password, nil, 
            required: true,
            minlength: 6,
            style: "width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px;" %>
      <small style="color: #666; font-size: 0.85rem;">Mínimo de 6 caracteres</small>
    </div>

    <!-- Confirmação -->
    <div style="margin-bottom: 30px;">
      <%= label_tag :password_confirmation, "Confirmar Nova Senha", style: "display: block; margin-bottom: 8px; font-weight: 500;" %>
      <%= password_field_tag :password_confirmation, nil, 
            required: true,
            minlength: 6,
            style: "width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px;" %>
    </div>

    <!-- Botões -->
    <div style="display: flex; gap: 10px; justify-content: flex-end;">
      <%= link_to "Cancelar", admin_perfil_path, 
            style: "background: #6c757d; color: white; padding: 10px 24px; border-radius: 6px; text-decoration: none; font-size: 14px;" %>
      <%= submit_tag "Alterar Senha", 
            style: "background: #6A2A8A; color: white; padding: 10px 24px; border-radius: 6px; border: none; cursor: pointer; font-size: 14px;" %>
    </div>
  <% end %>
</div>
