<%= form_with(model: [:admin, turma], local: true) do |f| %>

  <div class="card shadow-sm p-4">

    <div class="mb-3">
      <%= f.label :codigo, "Código da Turma", class: "form-label fw-semibold" %>
      <%= f.text_field :codigo, class: "form-control", required: true, placeholder: "Ex: CIC0001" %>
    </div>

    <div class="mb-3">
      <%= f.label :departamento, "Departamento", class: "form-label fw-semibold" %>
      <%= f.text_field :departamento, class: "form-control", required: true, placeholder: "Ex: Ciência da Computação" %>
    </div>

    <div class="mb-3">
      <%= f.label :semestre, "Semestre", class: "form-label fw-semibold" %>
      <%= f.text_field :semestre, class: "form-control", placeholder: "Ex: 2024/1" %>
    </div>

    <div class="d-flex justify-content-end">
      <%= f.submit class: "btn btn-primary px-4" %>
    </div>

  </div>

<% end %>