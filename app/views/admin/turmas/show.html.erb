<div class="container py-4">

  <h1 class="fw-bold mb-4"><%= @turma.codigo %></h1>

  <div class="card shadow-sm p-4">

    <p><strong>ID:</strong> <%= @turma.id %></p>
    <p><strong>Código:</strong> <%= @turma.codigo %></p>
    <p><strong>Departamento:</strong> <%= @turma.departamento %></p>
    <p><strong>Semestre:</strong> <%= @turma.semestre %></p>

    <div class="mt-3">
      <%= link_to "Editar", edit_admin_turma_path(@turma), class: "btn btn-primary me-2" %>
      <%= button_to "Excluir", admin_turma_path(@turma),
            method: :delete,
            form: { data: { turbo_confirm: "Tem certeza que deseja excluir esta turma?" }, class: "d-inline" },
            class: "btn btn-danger me-2" %>
      <%= link_to "Voltar", admin_turmas_path, class: "btn btn-secondary" %>
    </div>

  </div>

</div>