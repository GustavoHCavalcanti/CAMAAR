<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold text-primary">Formulários</h1>
    <%= link_to "Novo Formulário", new_admin_formulario_path, class: "btn btn-primary" %>
  </div>

  <% if @formularios.any? %>
    <table class="table table-hover shadow-sm">
      <thead class="table-light">
        <tr>
          <th>ID</th>
          <th>Título</th>
          <th>Criado em</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @formularios.each do |f| %>
          <tr>
            <td><%= f.id %></td>
            <td><%= f.titulo %></td>
            <td><%= l(f.created_at, format: :short) %></td>
            <td>
              <%= link_to "Ver", admin_formulario_path(f), class: "btn btn-sm btn-outline-primary" %>
              <%= link_to "Editar", edit_admin_formulario_path(f), class: "btn btn-sm btn-outline-secondary" %>
              <%= button_to "Excluir", admin_formulario_path(f),
                      method: :delete,
                      form: { data: { turbo_confirm: "Tem certeza?" }, class: "d-inline" },
                      class: "btn btn-sm btn-outline-danger" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="alert alert-info">Nenhum formulário cadastrado.</div>
  <% end %>
</div>