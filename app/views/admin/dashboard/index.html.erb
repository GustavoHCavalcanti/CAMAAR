<div class="container py-5">

  <h1 class="mb-4 fw-bold text-primary">
    Painel do Administrador
  </h1>

  <p class="text-muted mb-5">
    Bem-vindo ao painel administrativo do CAMAAR. Selecione uma das opções abaixo para gerenciar o sistema.
  </p>

  <div class="row g-4">

    <!-- Card: Formulários -->
    <div class="col-md-4">
      <div class="card shadow-sm h-100 border-0">
        <div class="card-body text-center">
          <div class="display-4 text-primary mb-3">
            📄
          </div>
          <h5 class="card-title fw-semibold">Formulários</h5>
          <p class="text-muted small mb-3">
            Crie e gerencie formulários usados nas avaliações.
          </p>
          <%= link_to "Gerenciar", admin_formularios_path, class: "btn btn-primary w-100" %>
        </div>
      </div>
    </div>

    <!-- Card: Templates -->
    <div class="col-md-4">
      <div class="card shadow-sm h-100 border-0">
        <div class="card-body text-center">
          <div class="display-4 text-primary mb-3">
            🧩
          </div>
          <h5 class="card-title fw-semibold">Templates</h5>
          <p class="text-muted small mb-3">
            Modele diferentes tipos de formulários pré-configurados.
          </p>
          <%= link_to "Gerenciar", admin_templates_path, class: "btn btn-primary w-100" %>
        </div>
      </div>
    </div>

    <!-- Card: Turmas -->
    <div class="col-md-4">
      <div class="card shadow-sm h-100 border-0">
        <div class="card-body text-center">
          <div class="display-4 text-primary mb-3">
            🏫
          </div>
          <h5 class="card-title fw-semibold">Turmas</h5>
          <p class="text-muted small mb-3">
            Cadastre turmas e associe participantes.
          </p>
          <%= link_to "Gerenciar", admin_turmas_path, class: "btn btn-primary w-100" %>
        </div>
      </div>
    </div>

  </div>
</div>