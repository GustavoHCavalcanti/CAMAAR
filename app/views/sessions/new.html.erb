<div class="container-fluid px-0">
  <div class="row g-0" style="min-height: 100vh;">

    <!-- ESQUERDA – FORMULÁRIO -->
    <div class="col-lg-6 d-flex align-items-center justify-content-center bg-white">

      <div style="width: 100%; max-width: 420px;">

        <h2 class="text-center fw-bold mb-5" style="letter-spacing: 1px;">
          LOGIN
        </h2>

        <% if flash[:alert] %>
          <div class="alert alert-danger">
            <%= flash[:alert] %>
          </div>
        <% end %>

        <%= form_with url: login_path, method: :post, local: true do %>

          <!-- EMAIL -->
          <div class="mb-4">
            <label class="form-label fw-semibold">Email</label>
            <%= text_field_tag :login, nil,
                class: "form-control form-control-lg",
                placeholder: "aluno@aluno.unb.br" %>
          </div>

          <!-- SENHA -->
          <div class="mb-4">
            <label class="form-label fw-semibold">Senha</label>
            <%= password_field_tag :password, nil,
                class: "form-control form-control-lg",
                placeholder: "Password" %>
          </div>

          <!-- BOTÃO -->
          <div class="d-grid mt-4">
            <button class="btn btn-lg text-white fw-semibold"
                    style="background-color: #4CAF50;">
              Entrar
            </button>
          </div>

        <% end %>

      </div>

    </div>

    <!-- DIREITA – PAINEL ROXO -->
    <div class="col-lg-6 d-flex align-items-center justify-content-center"
         style="background-color: #5A246E; color: white;">

      <div class="text-center px-4">
        <h1 class="fw-bold" style="font-size: 3.5rem; line-height: 1.2;">
          Bem vindo<br>
          ao<br>
          Camaar
        </h1>
      </div>

    </div>

  </div>
</div>