<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "CAMAAR" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="d-flex flex-column min-vh-100">

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
      <div class="container">

        <a class="navbar-brand fw-bold" href="/">
          CAMAAR
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMenu">
          <ul class="navbar-nav ms-auto mb-2 mb-lg-0">

            <li class="nav-item">
              <a class="nav-link" href="/">Início</a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/about">Sobre</a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/contact">Contato</a>
            </li>

            <!-- LOGIN / LOGOUT DINÂMICO -->
            <% if defined?(current_user) && current_user.present? %>

              <li class="nav-item d-flex align-items-center text-white me-3">
                Olá, <strong class="ms-1"><%= current_user.nome %></strong>
              </li>

              <li class="nav-item">
                <%= button_to "Sair", logout_path,
                      method: :delete,
                      class: "btn btn-outline-light px-3" %>
              </li>

            <% else %>

              <li class="nav-item ms-lg-3">
                <a class="btn btn-light text-primary fw-semibold px-3" href="/login">
                  Login
                </a>
              </li>
            <% end %>
          </ul>
        </div>

      </div>
    </nav>

    <!-- CONTEÚDO PRINCIPAL -->
    <main class="flex-grow-1">
      <%= yield %>
    </main>

    <!-- FOOTER -->
    <footer class="bg-light border-top mt-5 py-4">
      <div class="container text-center text-muted">

        <p class="mb-1">
          © <%= Time.current.year %> CAMAAR — Sistema de Avaliação da UnB
        </p>

        <p class="small">
          Desenvolvido por alunos da UnB
        </p>

      </div>
    </footer>

  </body>
</html>