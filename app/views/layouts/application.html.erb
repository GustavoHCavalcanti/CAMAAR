<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Camaar" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
      <div class="container">
        <a class="navbar-brand" href="/">Camaar</a>

        <div>
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item"><%= link_to "Home", root_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "Sobre", about_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "Contato", contact_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "Login", login_path, class: "nav-link" %></li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container mt-5">
      <%= yield %>
    </div>
  </body>
</html>