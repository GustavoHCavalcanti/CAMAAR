<div style="padding: 20px;">

  <h2 class="mb-4">Avaliações</h2>

  <!-- GRID DE CARDS -->
  <div data-avaliacoes-grid style="
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 24px;
    ">

    <% @formularios.each do |form| %>
      <div data-avaliacao-card style="
          background: white;
          padding: 20px;
          border-radius: 10px;
          box-shadow: 0 2px 6px rgba(0,0,0,0.12);
          position: relative;
          border-left: 4px solid #5E2A86;
        ">

        <h4 style="margin: 0 0 8px 0;"><%= form.titulo %></h4>
        
        <p class="text-muted" style="margin: 0 0 4px 0; font-size: 0.9rem;">
          <% if form.turma.present? %>
            <%= form.turma.codigo %> - <%= form.turma.departamento %>
            <% if form.turma.semestre.present? %>
              • <%= form.turma.semestre %>
            <% end %>
          <% end %>
        </p>

        <p class="text-muted" style="margin: 0 0 16px 0; font-size: 0.85rem;">
          <% if form.turma&.professor.present? %>
            <%= form.turma.professor %>
          <% else %>
            Professor não informado
          <% end %>
        </p>

        <!-- AÇÕES -->
        <div style="
            display: flex;
            gap: 10px;
          ">

          <% if @respondeu_hash[form.id] %>
            <!-- JÁ RESPONDEU: mostrar apenas "Ver Respostas" -->
            <%= link_to respondente_formulario_path(form),
                style: "flex: 1; text-align: center; padding: 8px; background: #1976d2; color: white; text-decoration: none; border-radius: 4px; font-weight: 500; font-size: 0.9rem;" do %>
              Ver Respostas
            <% end %>
          <% else %>
            <!-- AINDA NÃO RESPONDEU: mostrar apenas "Responder" -->
            <%= link_to respondente_formulario_path(form),
                style: "flex: 1; text-align: center; padding: 8px; background: #4CAF50; color: white; text-decoration: none; border-radius: 4px; font-weight: 500; font-size: 0.9rem;" do %>
              Responder
            <% end %>
          <% end %>

        </div>

      </div>
    <% end %>

  </div>

  <% if @formularios.empty? %>
    <div style="background: #e3f2fd; border-left: 3px solid #1976d2; padding: 16px; margin-top: 24px; border-radius: 4px; font-size: 0.9rem; text-align: center;">
      Nenhuma avaliação disponível no momento.
    </div>
  <% end %>

</div>