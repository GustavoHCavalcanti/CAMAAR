<div class="container py-5">

  <h1 class="mb-4 fw-bold text-center">Avaliações Disponíveis</h1>

  <% if @formularios.present? %>

    <div class="row g-4" data-avaliacoes-grid>

      <% @formularios.each do |form| %>
        <div class="col-md-6" data-avaliacao-card>
          <div class="card shadow-sm h-100">

            <div class="card-body">

              <h5 class="card-title fw-bold mb-1"><%= form.titulo %></h5>
              
              <p class="text-muted mb-1" style="font-size: 0.9rem;">
                <% if form.turma.present? %>
                  <%= form.turma.codigo %> - <%= form.turma.departamento %>
                  <% if form.turma.semestre.present? %>
                    • <%= form.turma.semestre %>
                  <% end %>
                <% end %>
              </p>

              <p class="text-muted mb-3" style="font-size: 0.85rem;">
                <% if form.turma&.professor.present? %>
                  <%= form.turma.professor %>
                <% else %>
                  Professor não informado
                <% end %>
              </p>

              <a href="<%= respondente_formulario_path(form) %>" class="btn btn-primary">
                Responder Avaliação
              </a>

            </div>
          </div>
        </div>
      <% end %>

    </div>

  <% else %>

    <div class="alert alert-info text-center mt-4">
      Nenhuma avaliação disponível no momento.
    </div>

  <% end %>

</div>