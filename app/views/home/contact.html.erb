<div class="container py-5">

  <!-- Título -->
  <div class="text-center mb-5">
    <h1 class="fw-bold">Contato</h1>
    <p class="text-muted fs-5 mt-3">
      Fale com a equipe do CAMAAR
    </p>
  </div>

  <div class="row justify-content-center">
    <div class="col-md-8">

      <!-- Card do formulário -->
      <div class="card shadow-sm border-0">
        <div class="card-body p-4">

          <h4 class="fw-semibold mb-4">Envie sua mensagem</h4>

          <%= form_with url: "#", method: :post, local: true do |f| %>

            <!-- Nome -->
            <div class="mb-3">
              <%= f.label :nome, "Nome", class: "form-label fw-semibold" %>
              <%= f.text_field :nome, class: "form-control", placeholder: "Seu nome completo" %>
            </div>

            <!-- Email -->
            <div class="mb-3">
              <%= f.label :email, "E-mail", class: "form-label fw-semibold" %>
              <%= f.email_field :email, class: "form-control", placeholder: "seuemail@exemplo.com" %>
            </div>

            <!-- Mensagem -->
            <div class="mb-3">
              <%= f.label :mensagem, "Mensagem", class: "form-label fw-semibold" %>
              <%= f.text_area :mensagem, rows: 5, class: "form-control", placeholder: "Escreva sua mensagem..." %>
            </div>

            <!-- Botão -->
            <div class="d-grid">
              <%= f.submit "Enviar mensagem", class: "btn btn-primary btn-lg" %>
            </div>

          <% end %>

        </div>
      </div>

      <!-- Informações adicionais -->
      <div class="mt-4 text-center text-muted">
        <p class="small">
          Responderemos o mais breve possível!
        </p>
      </div>

    </div>
  </div>

</div>